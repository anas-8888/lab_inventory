# ==========================================
# Example Environment (Safe for Git)
# Copy to .env (local) or .env.production (server)
# ==========================================

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=lab_inventory
DB_QUEUE_LIMIT=50
DB_SLOW_QUERY_MS=1500
DB_SLOW_ACQUIRE_MS=2000

# Runtime
NODE_ENV=development
PORT=3000
STATE=development

# Security
SESSION_SECRET=change-me-session-secret
COOKIE_SECRET=change-me-cookie-secret

# App URLs
BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000
APP_NAME=Lab Inventory System
PUBLIC_SITE_ALLOWED_ORIGINS=http://localhost:3000

# Backups
MYSQLDUMP_PATH=/usr/bin/mysqldump

# Uploads
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=50mb

# Logging
LOG_LEVEL=debug
LOG_PATH=./logs

# Server stability
REQUEST_TIMEOUT_MS=180000
KEEP_ALIVE_TIMEOUT_MS=65000
HEADERS_TIMEOUT_MS=66000
DB_ACQUIRE_TIMEOUT_MS=15000

# Monitoring
ENABLE_MEMORY_LOG=true
MEMORY_LOG_INTERVAL_MS=300000
HEAVY_REQUEST_THRESHOLD_MS=3000

# Puppeteer / Chrome
PUPPETEER_EXECUTABLE_PATH=
CHROME_PATH=
