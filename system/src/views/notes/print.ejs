<%
function fmtDate(d) {
  if (!d) return '-';
  const dt = new Date(d);
  if (Number.isNaN(dt.getTime())) return '-';
  const dd = String(dt.getDate()).padStart(2, '0');
  const mm = String(dt.getMonth() + 1).padStart(2, '0');
  const yy = dt.getFullYear();
  return `${dd}/${mm}/${yy}`;
}
function num(v) {
  if (v === null || v === undefined || v === '') return '-';
  if (typeof v === 'string' && /^-?\d+(\.\d+)?$/.test(v.trim())) return v.trim();
  const n = (typeof v === 'number') ? v : parseFloat(v);
  if (!Number.isFinite(n)) return '-';
  if (n === 0 || Object.is(n, -0)) return '0';
  const safe = Number(n.toFixed(12));
  let out = Number.isInteger(safe) ? String(safe) : safe.toString();
  out = out.replace(/(\.\d*?[1-9])0+$/, '$1').replace(/\.0+$/, '');
  if (out === '-0') out = '0';
  return safe < 0 ? ('\u200E' + out) : out;
}

const pageSize = 30;
const sourceRows = Array.isArray(notes) ? notes : [];
const pages = [];
for (let i = 0; i < sourceRows.length; i += pageSize) {
  pages.push(sourceRows.slice(i, i + pageSize));
}
if (pages.length === 0) pages.push([]);
%>
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title>تقرير الملاحظات</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&family=Amiri:wght@400;500;600;700&display=swap');

    @page {
      size: A4;
      margin: 14mm;
    }

    html, body {
      margin: 0;
      padding: 0;
      background: #fff;
      color: #111;
      direction: rtl;
      font-family: 'Cairo', 'Amiri', sans-serif;
      font-size: 9pt;
    }

    .page {
      page-break-after: always;
      min-height: 277mm;
      display: flex;
      flex-direction: column;
    }

    .page:last-child {
      page-break-after: auto;
    }

    .header-brand {
      width: 100%;
      border-collapse: collapse;
      margin-top: 2mm;
    }

    .header-wrap {
      margin: 0 8mm;
    }

    .header-brand td {
      vertical-align: middle;
    }

    .header-right,
    .header-left {
      font-weight: 700;
      line-height: 1.35;
      font-size: 8.5pt;
      width: 37%;
    }

    .header-right { text-align: right; }
    .header-left { text-align: left; }
    .header-logo { text-align: center; width: 26%; }
    .header-logo img { width: 72px; height: 72px; }

    .header-sep {
      border: 0;
      border-top: 1px solid #bbb;
      margin: 2mm 0;
    }

    .header-title {
      text-align: center;
      font-size: 10.5pt;
      font-weight: 700;
      margin: 0 0 2mm;
    }

    .table-wrap {
      margin: 0 8mm;
    }

    .content-table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }

    .content-table col:nth-child(1) { width: 7%; }
    .content-table col:nth-child(2) { width: 22%; }
    .content-table col:nth-child(3) { width: 12%; }
    .content-table col:nth-child(4) { width: 12%; }
    .content-table col:nth-child(5) { width: 14%; }
    .content-table col:nth-child(6) { width: 33%; }

    .content-table th,
    .content-table td {
      border: 1px solid #444;
      padding: 3px 4px;
      vertical-align: middle;
      word-break: break-word;
      line-height: 1.3;
    }

    .content-table th {
      background: #f3f3f3;
      text-align: center;
      font-weight: 700;
    }

    .content-table td {
      text-align: center;
    }

    .content-table td.notes-cell {
      text-align: right;
    }

    .footer {
      margin-top: 3mm;
      text-align: center;
      font-size: 8pt;
      line-height: 1.35;
      margin-top: auto;
    }

    .footer-sep {
      border: 0;
      border-top: 1px solid #bbb;
      margin: 0 8mm 1.5mm;
    }

    .page-index {
      margin-top: 1mm;
      font-size: 7.5pt;
      color: #555;
    }
  </style>
</head>
<body>
  <% pages.forEach((pageRows, pageIndex) => { %>
    <div class="page">
      <div class="header-wrap">
        <table class="header-brand">
          <tr>
            <td class="header-right">
              <div>مؤسسة عجاج أخوان التجارية</div>
              <div>لإنتاج وتعبئة المواد الغذائية</div>
              <div>وتجارة زيت الزيتون البكر</div>
              <div style="font-size:10px;">س.ت 10369 - س.ص 10</div>
            </td>
            <td class="header-logo">
              <img src="<%= baseUrl %>/public/images/nexa.png" alt="شعار">
            </td>
            <td class="header-left">
              <div>Ajaj Brothers Commercial Foundation</div>
              <div>For Food Production and Packaging</div>
              <div>And Virgin Olive Oil Trade</div>
              <div style="font-size:10px;">C.R. 10369 - I.R. 10</div>
            </td>
          </tr>
        </table>

        <hr class="header-sep">
        <p class="header-title">تقرير الملاحظات</p>
      </div>

      <div class="table-wrap">
        <table class="content-table">
          <colgroup>
            <col><col><col><col><col><col>
          </colgroup>
          <thead>
            <tr>
              <th>#</th>
              <th>اسم المادة</th>
              <th>السعر</th>
              <th>الوزن</th>
              <th>التاريخ</th>
              <th>الملاحظات</th>
            </tr>
          </thead>
          <tbody>
            <% for (let i = 0; i < pageSize; i++) { %>
              <% const n = pageRows[i]; %>
              <tr>
                <% if (n) { %>
                  <td><%= pageIndex * pageSize + i + 1 %></td>
                  <td><%= n.material_name || ('#' + (n.material_id || '-')) %></td>
                  <td><%= num(n.price) %></td>
                  <td><%= num(n.weight) %></td>
                  <td><%= fmtDate(n.note_date) %></td>
                  <td class="notes-cell"><%= n.note_text || '-' %></td>
                <% } else { %>
                  <td>&nbsp;</td>
                  <td>&nbsp;</td>
                  <td>&nbsp;</td>
                  <td>&nbsp;</td>
                  <td>&nbsp;</td>
                  <td>&nbsp;</td>
                <% } %>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="footer">
        <hr class="footer-sep">
        سوريا، حماة، أوتستراد دمشق-حلب الدولي، س.ت 10369 - س.ص 10<br>
        0940500511 - 0988111127 | ajajbrothers@gmail.com<br>
        جميع الحقوق محفوظة © <%= new Date().getFullYear() %> نظام إدارة المختبر | تم التطوير بواسطة شركة NEXA GROUP
        <div class="page-index">صفحة <%= pageIndex + 1 %> من <%= pages.length %></div>
      </div>
    </div>
  <% }) %>
</body>
</html>
