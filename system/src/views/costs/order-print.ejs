<% function fmtDate(d){ if(!d) return '-'; const dt=new Date(d); const dd=String(dt.getDate()).padStart(2,'0'); const mm=String(dt.getMonth()+1).padStart(2,'0'); const yy=dt.getFullYear(); return `${dd}/${mm}/${yy}`; }
function formatNumberDisplay(value) {
  if (value === null || value === undefined || value === '') return '-';
  if (typeof value === 'string' && /^-?\d+(\.\d+)?$/.test(value.trim())) return value.trim();
  const num = (typeof value === 'number') ? value : parseFloat(value);
  if (!Number.isFinite(num)) return '-';
  if (num === 0 || Object.is(num, -0)) return '0';
  const safe = Number(num.toFixed(12));
  let out = Number.isInteger(safe) ? String(safe) : safe.toString();
  out = out.replace(/(\.\d*?[1-9])0+$/,'$1').replace(/\.0+$/,'');
  if (out === '-0') out = '0';
  return safe < 0 ? ('\u200E' + out) : out;
}
function formatTotalDisplay(value) {
  const num = parseFloat(value);
  if (!Number.isFinite(num)) return '0';
  const normalized = Number.isInteger(num)
    ? String(num)
    : num.toFixed(6).replace(/0+$/,'').replace(/\.$/,'');
  const neg = normalized.startsWith('-');
  const clean = neg ? normalized.slice(1) : normalized;
  const [intPart, fracPart] = clean.split('.');
  const grouped = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  const out = grouped + (fracPart ? `.${fracPart}` : '');
  return neg ? ('\u200E-' + out) : out;
}
function formatDiscountDisplay(value) {
  const num = parseFloat(value);
  if (isNaN(num)) return '0.00';
  const fixed = num.toFixed(2);
  const [intPart, fracPart] = fixed.split('.');
  const grouped = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  return `${grouped}.${fracPart}`;
}
const currencySymbol = (typeof defaultCurrency !== 'undefined' && defaultCurrency && defaultCurrency.symbol) ? defaultCurrency.symbol : '';
const isEn = (typeof printLang !== 'undefined' && printLang === 'en');
const t = (ar, en) => isEn ? en : ar;
const selectedFields = new Set(Array.isArray(outputFields) ? outputFields : []);
const hasField = (field) => selectedFields.has(field);
const orderTableFields = ['material_number','material_name','packaging_unit','packaging_weight','pieces_per_package','gross_weight','requested_quantity','unit_price','total_price','item_notes'];
const activeOrderTableFields = orderTableFields.filter(hasField);
const orderTableColumnCount = activeOrderTableFields.length;
const orderTotalsLabelField = activeOrderTableFields.find(field => !['packaging_weight','pieces_per_package','gross_weight','requested_quantity','unit_price','total_price'].includes(field));
const totalBeforeDiscount = parseFloat(totals?.grandTotal) || 0;
const totalAfterDiscount = (typeof discountedTotal !== 'undefined' && discountedTotal !== null)
  ? (parseFloat(discountedTotal) || 0)
  : totalBeforeDiscount;
const discountValue = (typeof discountAmount !== 'undefined' && discountAmount !== null)
  ? Math.max(0, parseFloat(discountAmount) || 0)
  : Math.max(0, totalBeforeDiscount - totalAfterDiscount);
const hasDiscount = discountValue > 0;
%>

<% if (isEn) { %>
<div class="container-fluid lang-en" style="font-family: 'Cairo', 'Amiri', sans-serif;">
<% } else { %>
<div class="container-fluid" style="font-family: 'Cairo', 'Amiri', sans-serif;">
<% } %>
  <!-- Header -->
  <table style="width: 100%; border-collapse: collapse; margin-top: 10px; direction: rtl;">
    <tr>
      <td style="text-align: right; font-weight: bold; line-height: 1.4; width: 37%; font-size: 9pt;">
        <div>مؤسسة عجاج أخوان التجارية</div>
        <div>لإنتاج وتعبئة المواد الغذائية</div>
        <div>وتجارة زيت الزيتون البكر</div>
        <div style="font-size: 12px;">س.ت 10369 – س.ص 10</div>
      </td>
      <td style="text-align: center; width: 26%;">
        <img src="/public/images/nexa.png" alt="شعار" style="width: 90px; height: 90px;">
      </td>
      <td style="text-align: left; font-weight: bold; line-height: 1.4; width: 37%; font-size: 9pt;">
        <div>Ajaj Brothers Commercial Foundation</div>
        <div>For Food Production and Packaging</div>
        <div>And Virgin Olive Oil Trade</div>
        <div style="font-size: 12px;">C.R. 10369 – I.R. 10</div>
      </td>
    </tr>
  </table>
  <hr>

  <!-- Title -->
  <div style="text-align:center; margin: 12px 0;">
      <div style="font-size: 12pt; font-weight: 700;"><%= t('طلبية رقم', 'Order No.') %> (<%= order.order_number %>)</div>
  </div>

  <!-- Order Info -->
  <div class="info-stack">
    <% if (hasField('client_info') || hasField('recipient_name')) { %><div class="box-compact">
      <h6 class="section-title"><%= t('بيانات الزبون', 'Customer Info') %></h6>
      <div class="grid-kv">
        <% if (hasField('client_info')) { %><div class="kv"><span><%= t('الاسم:', 'Name:') %></span><span><%= order.client_name || '-' %></span></div><% } %>
        <% if (hasField('recipient_name') && order.recipient_name && String(order.recipient_name).trim()) { %>
        <div class="kv"><span><%= t('اسم المستلم:', 'Recipient Name:') %></span><span><%= order.recipient_name %></span></div>
        <% } %>
        <% if (hasField('client_info') && order.client_phone) { %><div class="kv"><span><%= t('الهاتف:', 'Phone:') %></span><span><%= order.client_phone %></span></div><% } %>
        <% if (hasField('client_info') && order.client_address) { %><div class="kv full"><span><%= t('العنوان:', 'Address:') %></span><span><%= order.client_address %></span></div><% } %>
      </div>
    </div><% } %>

    <% if (hasField('shipping_info')) { %>
    <div class="box-compact">
      <h6 class="section-title"><%= t('بيانات الشحن', 'Shipping Info') %></h6>
      <div class="grid-kv">
        <div class="kv"><span><%= t('تاريخ التسليم:', 'Delivery Date:') %></span><span><%= fmtDate(order.delivery_date) %></span></div>
      </div>
    </div>
    <% } %>
    
    <% if (hasField('dates') || hasField('preparation_info') || hasField('shipping_info')) { %>
    <div class="box-compact">
      <h6 class="section-title"><%= t('بيانات الطلبية', 'Order Info') %></h6>
      <div class="grid-kv">
        <% if (hasField('dates')) { const arabicOrderStatuses = { pending: 'قيد الانتظار', processing: 'قيد المعالجة', completed: 'مكتمل', cancelled: 'ملغى', canceled: 'ملغى' }; %><div class="kv"><span><%= t('التاريخ:', 'Date:') %></span><span><%= fmtDate(order.order_date) %></span></div><div class="kv"><span><%= t('تاريخ التسليم:', 'Delivery Date:') %></span><span><%= fmtDate(order.delivery_date) %></span></div><div class="kv"><span><%= t('الحالة:', 'Status:') %></span><span><%= arabicOrderStatuses[String(order.status || '').toLowerCase()] || order.status || '-' %></span></div><% } %>
        <% if (hasField('preparation_info') && order.responsible_worker) { %><div class="kv"><span><%= t('المسؤول:', 'Responsible:') %></span><span><%= order.responsible_worker %></span></div><% } %>
        <% if (hasField('preparation_info') && order.quality_controller) { %><div class="kv"><span><%= t('مراقب الجودة:', 'Quality Controller:') %></span><span><%= order.quality_controller %></span></div><% } %>
        <% if (hasField('shipping_info') && order.pallets_count != null) { %><div class="kv"><span><%= t('عدد الطبالي:', 'Pallets Count:') %></span><span><%= formatNumberDisplay(order.pallets_count) %></span></div><% } %>
        <% if (hasField('shipping_info') && order.container_number) { %><div class="kv"><span><%= t('رقم الحاوية:', 'Container No.:') %></span><span><%= order.container_number %></span></div><% } %>
        <% if (hasField('shipping_info') && order.packages_count != null) { %><div class="kv"><span><%= t('عدد الطرود:', 'Packages Count:') %></span><span><%= formatNumberDisplay(order.packages_count) %></span></div><% } %>
        <% if (hasField('shipping_info') && order.waybill_number) { %><div class="kv"><span><%= t('رقم البوليصة:', 'Waybill No.:') %></span><span><%= order.waybill_number %></span></div><% } %>
        <% if (hasField('shipping_info') && order.accreditation_number) { %><div class="kv"><span><%= t('رقم الاعتماد:', 'Accreditation No.:') %></span><span><%= order.accreditation_number %></span></div><% } %>
      </div>
    </div>
    <% } %>
    
    <% if (hasField('order_notes') && order.notes && String(order.notes).trim()) { %>
      <div class="box-compact">
        <h6 class="section-title"><%= t('ملاحظات الطلبية', 'Order Notes') %></h6>
        <div class="notes"><%= order.notes %></div>
      </div>
    <% } %>
  </div>

    
  <!-- Items Table -->
  <% if (orderTableColumnCount > 0) { %><div class="table-responsive" style="margin-top: 8px;">
    <table class="table-custom table-bordered align-middle" style="font-size: 9pt; width: 100%;">
      <thead>
        <tr>
          <% if(hasField('material_number')){%><th><%=t('رقم المادة','Material No.')%></th><%}%><% if(hasField('material_name')){%><th><%=t('اسم المادة','Material Name')%></th><%}%><% if(hasField('packaging_unit')){%><th><%=t('وحدة التعبئة','Packaging Unit')%></th><%}%><% if(hasField('packaging_weight')){%><th><%=t('الوزن','Weight')%></th><%}%><% if(hasField('pieces_per_package')){%><th><%=t('شد الكرتون','Pieces/Pack')%></th><%}%><% if(hasField('gross_weight')){%><th><%=t('وزن الطرد القائم','Gross Package Weight')%></th><%}%><% if(hasField('requested_quantity')){%><th><%=t('الكمية','Quantity')%></th><%}%><% if(hasField('unit_price')){%><th><%=t('السعر الإفرادي','Unit Price')%></th><%}%><% if(hasField('total_price')){%><th><%=t('السعر الإجمالي','Total Price')%></th><%}%><% if(hasField('item_notes')){%><th><%=t('الملاحظات','Notes')%></th><%}%>
        </tr>
      </thead>
      <tbody>
        <%
          const groupedOrderPrintMap = new Map();
          (items || []).forEach((it) => {
            const key = (it.material_name || '').trim();
            if (!groupedOrderPrintMap.has(key)) groupedOrderPrintMap.set(key, []);
            groupedOrderPrintMap.get(key).push(it);
          });
          const groupedOrderPrintRows = [];
          let orderRowNo = 1;
          Array.from(groupedOrderPrintMap.values()).forEach((group) => {
            group.forEach((it, idxInGroup) => {
              groupedOrderPrintRows.push({
                item: it,
                rowNumber: orderRowNo++,
                isFirstInGroup: idxInGroup === 0,
                groupLength: group.length
              });
            });
          });
        %>
        <% groupedOrderPrintRows.forEach((row) => { const item = row.item; %>
          <tr>
            <% if(hasField('material_number')){%><td class="num-cell"><%= item.material_number || '-' %></td><%}%>
            <% if (hasField('material_name') && row.isFirstInGroup) { %>
            <% if (isEn) { %>
            <td style="padding: 6pt 4pt; text-align: left;" rowspan="<%= row.groupLength %>"><%= item.material_name || '-' %></td>
            <% } else { %>
            <td style="padding: 6pt 4pt; text-align: right;" rowspan="<%= row.groupLength %>"><%= item.material_name || '-' %></td>
            <% } %>
            <% } %>
            <% if(hasField('packaging_unit')){%><td><%= item.unit || '-' %></td><%}%><% if(hasField('packaging_weight')){%><td class="num-cell"><%= formatNumberDisplay(item.packaging_weight) %></td><%}%><% if(hasField('pieces_per_package')){%><td class="num-cell"><%= formatNumberDisplay(item.pieces_per_package) %></td><%}%><% if(hasField('gross_weight')){%><td class="num-cell"><%= formatNumberDisplay(item.gross_weight) %></td><%}%><% if(hasField('requested_quantity')){%><td class="num-cell"><%= formatNumberDisplay(item.requested_quantity) %></td><%}%><% if(hasField('unit_price')){%><td class="num-cell"><%= `${formatNumberDisplay(item.unit_price)} ${currencySymbol}` %></td><%}%><% if(hasField('total_price')){%><td class="num-cell"><%= `${formatNumberDisplay(item.total_price)} ${currencySymbol}` %></td><%}%>
            <% if (hasField('item_notes') && isEn) { %>
            <td style="padding: 6pt 4pt; text-align: left;"><%= item.notes || '-' %></td>
            <% } else if (hasField('item_notes')) { %>
            <td style="padding: 6pt 4pt; text-align: right;"><%= item.notes || '-' %></td>
            <% } %>
          </tr>
        <% }) %>
      </tbody>
      <% if(hasField('totals')){%><tbody>
        <tr>
          <% activeOrderTableFields.forEach((field, index) => { %>
            <td class="<%= ['packaging_weight','gross_weight','requested_quantity','total_price'].includes(field) ? 'num-cell' : '' %>" style="font-weight:700"><% if (field === 'packaging_weight') { %><%= formatTotalDisplay(totals.totalPackagingWeight) %><% } else if (field === 'gross_weight') { %><%= formatTotalDisplay(totals.totalGrossWeight) %><% } else if (field === 'requested_quantity') { %><%= formatTotalDisplay(totals.totalRequestedQuantity) %><% } else if (field === 'total_price') { %><%= `${formatTotalDisplay(totalBeforeDiscount)} ${currencySymbol}` %><% } else if (field === orderTotalsLabelField) { %><%= t('الإجماليات','Totals') %><% } %></td>
          <% }) %>
        </tr>
        <% if (hasDiscount) { %>
        <tr>
          <td colspan="<%= Math.max(1,orderTableColumnCount-1) %>"><%= t('الخصم','Discount') %></td><td class="num-cell"><%= `- ${formatDiscountDisplay(discountValue)} ${currencySymbol}` %></td>
        </tr>
        <tr>
          <td colspan="<%= Math.max(1,orderTableColumnCount-1) %>"><%= t('الإجمالي بعد الخصم','Total After Discount') %></td><td class="num-cell"><%= `${formatDiscountDisplay(totalAfterDiscount)} ${currencySymbol}` %></td>
        </tr>
        <% } %>
      </tbody><%}%>
    </table>
  </div><%}%>

  <!-- Footer -->
  <div class="print-footer" id="fixed-print-footer" style="text-align:center; font-size: 8pt; margin-top: 10px;">
    <hr style="margin: 4px 0; border: 0.5px solid #bbb;">
    <% if (isEn) { %>
      Syria, Hama, Damascus-Aleppo International Highway, C.R. 10369 - P.O. Box 10<br>
      0940500511 - 0988111127 | ajajbrothers@gmail.com<br>
      All rights reserved © <%= new Date().getFullYear() %> Laboratory Management System | Developed by NEXA GROUP
    <% } else { %>
      سوريا، حماة، أوتستراد دمشق-حلب الدولي، س.ت 10369 – س.ص 10<br>
      0940500511 – 0988111127 | ajajbrothers@gmail.com<br>
      جميع الحقوق محفوظة © <%= new Date().getFullYear() %> نظام إدارة المختبر | تم التطوير بواسطة شركة NEXA GROUP
    <% } %>
  </div>
</div>

<script>
  // طباعة تلقائية عند الفتح
  window.addEventListener('load', function(){
    setTimeout(function(){ window.print(); }, 200);
  });

  // إغلاق التبويب بعد إغلاق نافذة الطباعة (سواء طبع أو ألغى)
  function closeAfterPrint(){
    setTimeout(function(){
      try { window.close(); } catch(e) {}
    }, 100);
  }
  if ('onafterprint' in window) {
    window.addEventListener('afterprint', closeAfterPrint);
  }
  // متصفح قديم: مراقبة التبديل إلى/من وضع الطباعة
  var mql = window.matchMedia && window.matchMedia('print');
  if (mql) {
    if (mql.addEventListener) {
      mql.addEventListener('change', function(e){ if (!e.matches) closeAfterPrint(); });
    } else if (mql.addListener) {
      mql.addListener(function(e){ if (!e.matches) closeAfterPrint(); });
    }
  }
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&family=Amiri:wght@400;500;600;700&display=swap');
  @page { size: A4 portrait; margin: 1cm; }
  html, body { background: #fff !important; margin:0; padding:0; direction: rtl; text-align: right; font-family: 'Cairo','Amiri','Noto Naskh Arabic',sans-serif !important; font-size: 9pt; }
  .table-custom { width: 100%; border-collapse: separate; border-spacing: 0; }
  .table-custom th, .table-custom td { border: 1px solid #444; padding: 6pt 4pt; }
  .table-custom th { background: #f5f5f5; font-weight: 700; }
  .table-custom td.num-cell { text-align: center !important; white-space: nowrap; }
  thead { display: table-header-group; }
  tfoot { display: none; }
  tr { page-break-inside: avoid; }
  .table-responsive { overflow-x: visible; }

  .info-stack { display: flex; flex-direction: column; gap: 6px; }
  .box-compact { border: 1px solid #ccc; padding: 6pt; border-radius: 4px; }
  .section-title { font-size: 10pt; font-weight: 700; margin: 0 0 4pt 0; }
  .grid-kv { display: grid; grid-template-columns: 1fr 1fr; gap: 2pt 8pt; }
  .kv { display: flex; justify-content: space-between; border-bottom: 1px dashed #e0e0e0; padding: 2pt 0; }
  .kv.full { grid-column: 1 / -1; }
  .kv span:first-child { color: #333; font-weight: 600; margin-left: 8px; }
  .notes { white-space: pre-wrap; line-height: 1.6; }
  .container-fluid.lang-en { direction: ltr; text-align: left; }
  .container-fluid.lang-en .kv span:first-child { margin-left: 0; margin-right: 8px; }

  /* مساحة أسفل المحتوى لمنع تداخل الفوتر المثبت */
  .container-fluid { padding-bottom: 80px; }
  .print-footer { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; }

  /* تقليل ارتفاع الصفوف لعدد مواد كبير */
  .table-custom th, .table-custom td { padding: 4pt 3pt; }
</style>




