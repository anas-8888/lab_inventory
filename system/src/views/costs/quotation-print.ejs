<% function fmtDate(d){ if(!d) return '-'; const dt=new Date(d); const dd=String(dt.getDate()).padStart(2,'0'); const mm=String(dt.getMonth()+1).padStart(2,'0'); const yy=dt.getFullYear(); return `${dd}/${mm}/${yy}`; }
function formatNumberDisplay(value) {
  if (value === null || value === undefined || value === '') return '-';
  if (typeof value === 'string' && /^-?\d+(\.\d+)?$/.test(value.trim())) return value.trim();
  const num = (typeof value === 'number') ? value : parseFloat(value);
  if (!Number.isFinite(num)) return '-';
  if (num === 0 || Object.is(num, -0)) return '0';
  const safe = Number(num.toFixed(12));
  let out = Number.isInteger(safe) ? String(safe) : safe.toString();
  out = out.replace(/(\.\d*?[1-9])0+$/,'$1').replace(/\.0+$/,'');
  if (out === '-0') out = '0';
  return safe < 0 ? ('\u200E' + out) : out;
}
function formatTotalDisplay(value) {
  const num = parseFloat(value);
  if (!Number.isFinite(num)) return '0';
  const normalized = Number.isInteger(num)
    ? String(num)
    : num.toFixed(6).replace(/0+$/,'').replace(/\.$/,'');
  const neg = normalized.startsWith('-');
  const clean = neg ? normalized.slice(1) : normalized;
  const [intPart, fracPart] = clean.split('.');
  const grouped = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  const out = grouped + (fracPart ? `.${fracPart}` : '');
  return neg ? ('\u200E-' + out) : out;
}
function formatDiscountDisplay(value) {
  const num = parseFloat(value);
  if (isNaN(num)) return '0.00';
  const fixed = num.toFixed(2);
  const [intPart, fracPart] = fixed.split('.');
  const grouped = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  return `${grouped}.${fracPart}`;
}
const currencySymbol = (typeof defaultCurrency !== 'undefined' && defaultCurrency && defaultCurrency.symbol) ? defaultCurrency.symbol : '';
const isEn = (typeof printLang !== 'undefined' && printLang === 'en');
const t = (ar, en) => isEn ? en : ar;
const selectedFields = new Set(Array.isArray(outputFields) ? outputFields : []);
const hasField = (field) => selectedFields.has(field);
const tableFields = ['row_number','material_number','material_name','material_type','packaging_unit','packaging_weight','pieces_per_package','package_cost','profit_percentage','final_price','quantity','total_price','item_notes'];
const activeQuotationTableFields = tableFields.filter(hasField);
const quotationTableColumnCount = activeQuotationTableFields.length;
const totalBeforeDiscount = parseFloat(grandTotal) || 0;
const totalAfterDiscount = (typeof discountedTotal !== 'undefined' && discountedTotal !== null)
  ? (parseFloat(discountedTotal) || 0)
  : totalBeforeDiscount;
const discountValue = (typeof discountAmount !== 'undefined' && discountAmount !== null)
  ? Math.max(0, parseFloat(discountAmount) || 0)
  : Math.max(0, totalBeforeDiscount - totalAfterDiscount);
const hasDiscount = discountValue > 0;
const renderQuotationTotalRow = (label, value) => {
  const labelField = activeQuotationTableFields.find(field => !['packaging_weight','pieces_per_package','package_cost','profit_percentage','final_price','quantity','total_price'].includes(field));
  return `<tr class="total-row">${activeQuotationTableFields.map((field, index) => {
    if (field === 'total_price') return `<td class="num-cell" style="font-weight:700"><span class="money-inline">${value}</span></td>`;
    if (field === labelField) return `<td style="font-weight:700">${label}</td>`;
    if (!labelField && index === 0) return `<td class="num-cell" style="font-weight:700">${label}: <span class="money-inline">${value}</span></td>`;
    return '<td></td>';
  }).join('')}</tr>`;
};
%>

<% if (isEn) { %>
<div class="container-fluid lang-en" style="font-family: 'Cairo','Amiri',sans-serif;">
<% } else { %>
<div class="container-fluid" style="font-family: 'Cairo','Amiri',sans-serif;">
<% } %>
  <!-- Header -->
  <table style="width: 100%; border-collapse: collapse; margin-top: 4px; direction: rtl;">
    <tr>
      <td style="text-align: right; font-weight: bold; line-height: 1.2; width: 37%; font-size: 9pt;">
        <div>مؤسسة عجاج أخوان التجارية</div>
        <div>لإنتاج وتعبئة المواد الغذائية</div>
        <div>وتجارة زيت الزيتون البكر</div>
        <div style="font-size: 12px;">س.ت 10369 – س.ص 10</div>
      </td>
      <td style="text-align: center; width: 26%;">
        <img src="/public/images/nexa.png" alt="شعار" style="width: 70px; height: 70px;">
      </td>
      <td style="text-align: left; font-weight: bold; line-height: 1.2; width: 37%; font-size: 9pt;">
        <div>Ajaj Brothers Commercial Foundation</div>
        <div>For Food Production and Packaging</div>
        <div>And Virgin Olive Oil Trade</div>
        <div style="font-size: 12px;">C.R. 10369 – I.R. 10</div>
      </td>
    </tr>
  </table>
  <hr style="margin: 4px 0; border: 0.5px solid #bbb;">

  <!-- Title -->
  <div style="text-align:center; margin: 6px 0;">
    <div style="font-size: 11pt; font-weight: 700;"><%= t('عرض سعر رقم', 'Quotation No.') %> (<%= quotation.quotation_number %>)</div>
  </div>

  <!-- Customer/Quotation Info -->
  <div class="info-grid">
    <% if (hasField('client_info') || hasField('sale_description') || hasField('payment_method')) { %>
    <div class="box-compact">
      <h6 class="section-title"><%= t('بيانات العميل', 'Customer Info') %></h6>
      <div class="grid-kv">
        <% if (hasField('client_info')) { %><div class="kv"><span><%= t('الاسم:', 'Name:') %></span><span><%= quotation.client_name || '-' %></span></div><% } %>
        <% if (hasField('client_info') && quotation.client_phone) { %><div class="kv"><span><%= t('الهاتف:', 'Phone:') %></span><span><%= quotation.client_phone %></span></div><% } %>
        <% if (hasField('client_info') && quotation.client_address) { %><div class="kv full"><span><%= t('العنوان:', 'Address:') %></span><span><%= quotation.client_address %></span></div><% } %>
        <% if (hasField('sale_description') && quotation.sale_description) { %><div class="kv"><span><%= t('صفة البيع:', 'Sale Type:') %></span><span><%= quotation.sale_description %></span></div><% } %>
        <% if (hasField('payment_method') && quotation.payment_method) { %><div class="kv"><span><%= t('طريقة الدفع:', 'Payment Method:') %></span><span><%= quotation.payment_method %></span></div><% } %>
      </div>
    </div>
    <% } %>
    <% if (hasField('client_info') || hasField('totals')) { %><div class="box-compact">
      <h6 class="section-title"><%= t('بيانات العرض', 'Quotation Info') %></h6>
      <div class="grid-kv">
        <% if (hasField('client_info')) { %><div class="kv"><span><%= t('التاريخ:', 'Date:') %></span><span><%= fmtDate(quotation.created_at) %></span></div><div class="kv"><span><%= t('عدد المواد:', 'Items Count:') %></span><span><%= (items||[]).length %></span></div><% } %>
          <% if (hasField('totals')) { %><div class="kv"><span><%= t('إجمالي السعر:', 'Total Amount:') %></span><span class="money-inline"><%= `${formatTotalDisplay(totalBeforeDiscount)} ${currencySymbol}` %></span></div><% } %>
        <% if (hasField('totals') && hasDiscount) { %>
          <div class="kv"><span><%= t('الخصم:', 'Discount:') %></span><span class="money-inline"><%= `- ${formatDiscountDisplay(discountValue)} ${currencySymbol}` %></span></div>
          <div class="kv"><span><%= t('الإجمالي بعد الخصم:', 'Total After Discount:') %></span><span class="money-inline"><%= `${formatDiscountDisplay(totalAfterDiscount)} ${currencySymbol}` %></span></div>
        <% } %>
      </div>
    </div><% } %>
    <% if (hasField('quotation_notes') && quotation.notes) { %>
      <div class="box-compact">
        <h6 class="section-title"><%= t('ملاحظات', 'Notes') %></h6>
        <div class="notes"><%= quotation.notes %></div>
      </div>
    <% } %>
  </div>

  <!-- Items Table -->
  <% if (quotationTableColumnCount > 0) { %><div class="table-responsive" style="margin-top: 6px;">
    <table class="table-custom table-bordered align-middle" style="font-size: 10pt; width: 100%;">
      <thead>
        <tr>
          <% if (hasField('row_number')) { %><th>#</th><% } %>
          <% if (hasField('material_number')) { %><th><%= t('رقم المادة','Material No.') %></th><% } %>
          <% if (hasField('material_name')) { %><th><%= t('الصنف', 'Item') %></th><% } %>
          <% if (hasField('material_type')) { %><th><%= t('النوع','Type') %></th><% } %>
          <% if (hasField('packaging_unit')) { %><th><%= t('التعبئة', 'Packaging') %></th><% } %>
          <% if (hasField('packaging_weight')) { %><th><%= t('حجم العبوة', 'Pack Weight') %></th><% } %>
          <% if (hasField('pieces_per_package')) { %><th><%= t('شد الكرتون', 'Pieces/Pack') %></th><% } %>
          <% if (hasField('package_cost')) { %>
          <th style="width: 12%; padding: 2pt 2pt;"><%= t('كلفة الطرد', 'Package Cost') %></th>
          <% } %><% if (hasField('profit_percentage')) { %>
          <th style="width: 8%; padding: 2pt 2pt;"><%= t('نسبة الربح', 'Profit %') %></th>
          <% } %>
          <% if (hasField('final_price')) { %><th><%= t('السعر', 'Price') %></th><% } %>
          <% if (hasField('quantity')) { %><th><%= t('الكمية', 'Quantity') %></th><% } %>
          <% if (hasField('total_price')) { %><th><%= t('المجموع', 'Total') %></th><% } %>
          <% if (hasField('item_notes')) { %><th><%= t('ملاحظات', 'Notes') %></th><% } %>
        </tr>
      </thead>
      <tbody>
        <% const rowsPerPage = 36; const rowsOnFirstPage = 21; %>
        <%
          const groupedQuotationPrintMap = new Map();
          (items || []).forEach((it) => {
            const key = (it.material_name || '').trim();
            if (!groupedQuotationPrintMap.has(key)) groupedQuotationPrintMap.set(key, []);
            groupedQuotationPrintMap.get(key).push(it);
          });
          const groupedQuotationPrintRows = [];
          let rowNo = 1;
          Array.from(groupedQuotationPrintMap.values()).forEach((group) => {
            group.forEach((it, idxInGroup) => {
              groupedQuotationPrintRows.push({
                item: it,
                rowNumber: rowNo++,
                isFirstInGroup: idxInGroup === 0,
                groupLength: group.length
              });
            });
          });
        %>
        <% groupedQuotationPrintRows.forEach((row, idx) => { const item = row.item; %>
          <% if (idx === rowsOnFirstPage || (idx > rowsOnFirstPage && ((idx - rowsOnFirstPage) % rowsPerPage) === 0)) { %>
            <tr class="page-break"><td colspan="<%= quotationTableColumnCount %>"></td></tr>
          <% } %>
          <tr>
            <% if (hasField('row_number')) { %><td class="num-cell"><%= row.rowNumber %></td><% } %>
            <% if (hasField('material_number')) { %><td class="num-cell"><%= item.material_number || '-' %></td><% } %>
            <% if (hasField('material_name') && row.isFirstInGroup) { %>
            <% if (isEn) { %>
            <td style="padding: 2pt 2pt; text-align: left; line-height: 1.15;" rowspan="<%= row.groupLength %>">
            <% } else { %>
            <td style="padding: 2pt 2pt; text-align: right; line-height: 1.15;" rowspan="<%= row.groupLength %>">
            <% } %>
              <div><%= item.material_name || '-' %></div>
            </td>
            <% } %>
            <% if (hasField('material_type')) { %><td><%= item.material_type || '-' %></td><% } %>
            <% if (hasField('packaging_unit')) { %><td><%= item.packaging_unit || '-' %></td><% } %>
            <% if (hasField('packaging_weight')) { %><td class="num-cell"><%= item.packaging_weight != null ? formatNumberDisplay(item.packaging_weight) : '-' %></td><% } %>
            <% if (hasField('pieces_per_package')) { %><td class="num-cell"><%= item.pieces_per_package != null ? formatNumberDisplay(item.pieces_per_package) : '-' %></td><% } %>
            <% if (hasField('package_cost')) { %>
            <td class="num-cell" style="padding: 2pt 2pt;"><span class="money-inline"><%= `${formatNumberDisplay(item.package_cost)} ${currencySymbol}` %></span></td>
            <% } %><% if (hasField('profit_percentage')) { %>
            <td class="num-cell" style="padding: 2pt 2pt;"><%= `${formatNumberDisplay(item.profit_percentage || 0)}%` %></td>
            <% } %>
            <% if (hasField('final_price')) { %><td class="num-cell"><%= `${formatNumberDisplay(item.final_price)} ${currencySymbol}` %></td><% } %>
            <% if (hasField('quantity')) { %><td class="num-cell"><%= item.quantity != null ? formatNumberDisplay(item.quantity) : '-' %></td><% } %>
            <% if (hasField('total_price')) { %><td class="num-cell"><%= `${formatNumberDisplay(item.total_price)} ${currencySymbol}` %></td><% } %>
            <% if (hasField('item_notes')) { %><td><%= item.item_notes || '-' %></td><% } %>
          </tr>
        <% }) %>
        <% if (hasField('totals') && (groupedQuotationPrintRows||[]).length <= rowsOnFirstPage) { %>
          <%- renderQuotationTotalRow(t('الإجمالي','Total'), `${formatTotalDisplay(totalBeforeDiscount)} ${currencySymbol}`) %>
          <% if (hasDiscount) { %>
          <%- renderQuotationTotalRow(t('الخصم','Discount'), `- ${formatDiscountDisplay(discountValue)} ${currencySymbol}`) %>
          <%- renderQuotationTotalRow(t('الإجمالي بعد الخصم','Total After Discount'), `${formatDiscountDisplay(totalAfterDiscount)} ${currencySymbol}`) %>
          <% } %>
        <% } else if (hasField('totals')) { %>
          <% const remainder = ((groupedQuotationPrintRows||[]).length - rowsOnFirstPage) % rowsPerPage; %>
          <% const isExactMultiple = remainder === 0; %>
          <% if (isExactMultiple) { %>
            <tr class="page-break"><td colspan="<%= quotationTableColumnCount %>"></td></tr>
          <% } %>
          <%- renderQuotationTotalRow(t('الإجمالي','Total'), `${formatTotalDisplay(totalBeforeDiscount)} ${currencySymbol}`) %>
          <% if (hasDiscount) { %>
          <%- renderQuotationTotalRow(t('الخصم','Discount'), `- ${formatDiscountDisplay(discountValue)} ${currencySymbol}`) %>
          <%- renderQuotationTotalRow(t('الإجمالي بعد الخصم','Total After Discount'), `${formatDiscountDisplay(totalAfterDiscount)} ${currencySymbol}`) %>
          <% } %>
        <% } %>
      </tbody>
      
    </table>
  </div><% } %>

  <!-- Footer -->
  <div class="print-footer" id="fixed-print-footer" style="text-align:center; font-size: 8.5pt; margin-top: 6px;">
    <hr style="margin: 4px 0; border: 0.5px solid #bbb;">
    <% if (isEn) { %>
      Syria, Hama, Damascus-Aleppo International Highway, C.R. 10369 - P.O. Box 10<br>
      0940500511 - 0988111127 | ajajbrothers@gmail.com<br>
      All rights reserved © <%= new Date().getFullYear() %> Laboratory Management System | Developed by NEXA GROUP
    <% } else { %>
      سوريا، حماة، أوتستراد دمشق-حلب الدولي، س.ت 10369 – س.ص 10<br>
      0940500511 – 0988111127 | ajajbrothers@gmail.com<br>
      جميع الحقوق محفوظة © <%= new Date().getFullYear() %> نظام إدارة المختبر | تم التطوير بواسطة شركة NEXA GROUP
    <% } %>
  </div>
</div>

<script>
  window.addEventListener('load', function(){ setTimeout(function(){ window.print(); }, 200); });
  function closeAfterPrint(){ setTimeout(function(){ try{ window.close(); }catch(e){} }, 100); }
  if ('onafterprint' in window) { window.addEventListener('afterprint', closeAfterPrint); }
  var mql = window.matchMedia && window.matchMedia('print');
  if (mql) {
    if (mql.addEventListener) { mql.addEventListener('change', function(e){ if(!e.matches) closeAfterPrint(); }); }
    else if (mql.addListener) { mql.addListener(function(e){ if(!e.matches) closeAfterPrint(); }); }
  }
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&family=Amiri:wght@400;500;600;700&display=swap');
  @page { size: A4 portrait; margin: 1cm 1cm 0.8cm 1cm; }
  html, body { background: #fff !important; margin:0; padding:0; direction: rtl; text-align: right; font-family: 'Cairo','Amiri','Noto Naskh Arabic',sans-serif !important; font-size: 9.5pt; }
  .table-custom { width: 100%; border-collapse: separate; border-spacing: 0; }
  .table-custom th, .table-custom td { border: 0.7px solid #444; }
  .table-custom th { background: #f5f5f5; font-weight: 700; }
  .table-custom td.num-cell { text-align: center !important; white-space: nowrap; }
  thead { display: table-header-group; }
  tfoot { display: none; }
  tr { page-break-inside: avoid; }
  .table-responsive { overflow-x: visible; }
  .info-grid { display: grid; grid-template-columns: 1fr; gap: 4pt; }
  .box-compact { border: 1px solid #ccc; padding: 4pt; border-radius: 3px; }
  .section-title { font-size: 9pt; font-weight: 700; margin: 0 0 2pt 0; }
  .grid-kv { display: grid; grid-template-columns: 1fr 1fr; gap: 2pt 6pt; }
  .kv { display: grid; grid-template-columns: auto 1fr; column-gap: 6pt; border-bottom: 1px dashed #e0e0e0; padding: 1pt 0; align-items: start; }
  .kv.full { grid-column: 1 / -1; }
  .kv span:first-child { color: #333; font-weight: 600; margin-left: 6px; }
  .kv span:last-child { white-space: normal; word-break: break-word; }
  .notes { white-space: pre-wrap; line-height: 1.3; font-size: 9pt; }
  .container-fluid.lang-en { direction: ltr; text-align: left; }
  .container-fluid.lang-en .kv span:first-child { margin-left: 0; margin-right: 6px; }
  .money-inline { white-space: nowrap; display: inline-block; }
  .container-fluid { padding-bottom: 120px; }
  .print-footer { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; }
  .table-custom th, .table-custom td { padding: 3pt 2pt; line-height: 1.3; }
  .page-break { page-break-before: always; break-before: page; height: 0; }
  .table-custom tr.page-break td { border: 0; padding: 0; height: 0; }
  .total-row td { background: #f5f5f5; }
</style>


