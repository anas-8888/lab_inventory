<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><title><%= title %></title><style>
@page{size:A4;margin:12mm}*{box-sizing:border-box}body{font-family:Arial,Tahoma,sans-serif;margin:0;color:#17202a;font-size:12px}.header{display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #222;padding-bottom:12px;margin-bottom:18px}.header h1{font-size:20px;margin:0}.header small{display:block;margin-top:5px;color:#555}.logo{font-size:24px;font-weight:bold}.footer{border-top:1px solid #aaa;margin-top:20px;padding-top:8px;text-align:center;color:#666;font-size:10px}.meta{text-align:left;font-size:11px;color:#555;margin-bottom:10px}table{width:100%;border-collapse:collapse}th,td{border:1px solid #777;padding:8px;text-align:center;vertical-align:middle}th{font-weight:bold;background:#eee}td.materials{text-align:right;line-height:1.6}
</style></head><body><header class="header"><div><h1>قائمة الماركات</h1><small>نظام إدارة المختبر</small></div><div class="logo">AJB</div></header><div class="meta">تاريخ الطباعة: <%= new Date().toLocaleDateString('ar-SY') %></div><table><thead><tr><th>اسم الماركة</th><th>اسم صاحبها</th><th>العنوان</th><th>رقم التواصل</th><th>المواد</th></tr></thead><tbody><% brands.forEach((brand) => { %><tr><td><%= brand.brand_name %></td><td><%= brand.owner_name || '-' %></td><td><%= brand.address || '-' %></td><td><%= brand.contact_number || '-' %></td><td class="materials"><%= brand.materials || 'لا توجد مواد' %></td></tr><% }) %></tbody></table><footer class="footer">جميع الحقوق محفوظة © <%= new Date().getFullYear() %> نظام إدارة المختبر</footer></body></html>
