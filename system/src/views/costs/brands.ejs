<div class="container mt-4" dir="rtl">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h2><i class="bi bi-tags"></i> الماركات</h2>
    <div class="d-flex flex-wrap gap-2">
      <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#brandModal" onclick="openBrandModal()"><i class="bi bi-plus-circle"></i> إضافة ماركة</button>
      <button class="btn btn-outline-primary" onclick="openExportModal()"><i class="bi bi-download"></i> تصدير المحدد</button>
      <button id="deleteSelectedBtn" class="btn btn-outline-danger" onclick="openDeleteModal()" disabled><i class="bi bi-trash"></i> حذف المحدد</button>
      <a class="btn btn-outline-secondary" href="/costs"><i class="bi bi-arrow-right"></i> العودة للتكاليف</a>
    </div>
  </div>
  <div class="card shadow-sm">
    <div class="card-header"><div class="row g-2"><div class="col-md-7"><input id="brandFilter" class="form-control" placeholder="بحث باسم الماركة أو صاحبها أو رقم التواصل"></div><div class="col-md-3"><select id="brandMaterialFilter" class="form-select"><option value="">كل الماركات</option><option value="with">مرتبطة بمواد</option><option value="without">بدون مواد</option></select></div></div></div>
    <div class="card-body"><div class="table-responsive"><table class="table table-hover align-middle text-center" id="brandsTable"><thead><tr><th><input type="checkbox" id="selectAllBrands" aria-label="تحديد الكل"></th><th>اسم الماركة</th><th>اسم صاحبها</th><th>العنوان</th><th>رقم التواصل</th><th>عدد المواد</th><th>الإجراءات</th></tr></thead><tbody>
      <% brands.forEach((brand) => { %><tr data-id="<%= brand.id %>" data-search="<%= [brand.brand_name, brand.owner_name, brand.contact_number, brand.address].filter(Boolean).join(' ').toLowerCase() %>" data-material-count="<%= brand.materials_count %>"><td><input type="checkbox" class="brand-check" value="<%= brand.id %>" aria-label="تحديد <%= brand.brand_name %>"></td><td><strong><%= brand.brand_name %></strong></td><td><%= brand.owner_name || '-' %></td><td><%= brand.address || '-' %></td><td><%= brand.contact_number || '-' %></td><td><span class="badge text-bg-secondary"><%= brand.materials_count %></span></td><td><div class="btn-group"><button class="btn btn-sm btn-info" title="استعراض" onclick="viewBrand(<%= brand.id %>)"><i class="bi bi-eye"></i></button><button class="btn btn-sm btn-outline-success" title="تعديل" onclick="editBrand(<%= brand.id %>)"><i class="bi bi-pencil"></i></button><button class="btn btn-sm btn-danger" title="حذف" onclick="requestDeleteBrand(<%= brand.id %>)"><i class="bi bi-trash"></i></button></div></td></tr><% }) %>
    </tbody></table></div><div id="emptyBrands" class="text-center text-muted py-4 d-none">لا توجد نتائج</div></div>
  </div>
</div>

<div class="modal fade" id="brandModal" tabindex="-1"><div class="modal-dialog modal-xl modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 id="brandModalTitle" class="modal-title">إضافة ماركة</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><form id="brandForm"><input type="hidden" id="brandId"><div class="row g-3"><div class="col-md-6"><label class="form-label">اسم الماركة *</label><input id="brandName" class="form-control" required></div><div class="col-md-6"><label class="form-label">اسم صاحبها</label><input id="brandOwner" class="form-control"></div><div class="col-md-6"><label class="form-label">رقم التواصل</label><input id="brandContact" class="form-control"></div><div class="col-md-6"><label class="form-label">العنوان</label><input id="brandAddress" class="form-control"></div><div class="col-12"><label class="form-label">المواد التابعة للماركة</label><input id="materialSearch" class="form-control mb-2" placeholder="ابحث ثم اختر المواد"><div id="materialChoices" class="border rounded p-2" style="max-height:280px;overflow-y:auto"><% materials.forEach((material) => { %><label class="material-choice d-flex align-items-center gap-2 p-2" data-text="<%= `${material.material_number || ''} ${material.material_name} ${material.material_type || ''}`.toLowerCase() %>"><input type="checkbox" class="brand-material" value="<%= material.id %>"><span><%= material.material_name %><small class="text-muted d-block"><%= material.material_number || '' %> <%= material.material_type || '' %></small></span></label><% }) %></div></div></div></form></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button><button class="btn btn-success" onclick="saveBrand()">حفظ</button></div></div></div></div>
<div class="modal fade" id="deleteBrandModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title"><i class="bi bi-exclamation-triangle text-danger"></i> تأكيد الحذف</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body" id="deleteBrandMessage"></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button><button class="btn btn-danger" onclick="confirmDeleteBrands()">تأكيد الحذف</button></div></div></div></div>
<style>
  #brandViewModal .modal-dialog { max-width: 760px; }
  #brandViewModal .modal-content { border: 0; border-radius: 18px; overflow: hidden; box-shadow: 0 18px 55px rgba(0,0,0,.2); }
  #brandViewModal .modal-header { padding: 1.25rem 1.5rem; background: linear-gradient(135deg,#f1f8f4,#fff); border-bottom: 1px solid #e5e7eb; }
  #brandViewModal .modal-body { padding: 1.5rem; max-height: 68vh; overflow-y: auto; }
  .brand-view-hero { display:flex; align-items:center; gap:1rem; padding:1rem; margin-bottom:1.25rem; border-radius:14px; background:#f8fafc; border:1px solid #e5e7eb; }
  .brand-view-icon { width:52px; height:52px; display:grid; place-items:center; border-radius:50%; font-size:1.5rem; background:#198754; color:#fff; }
  .brand-view-hero h4 { margin:0; font-weight:700; }.brand-view-hero small,.brand-view-info-card .label { color:#6b7280; }
  .brand-view-info { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.75rem; margin-bottom:1.5rem; }
  .brand-view-info-card { padding:.85rem 1rem; border:1px solid #e5e7eb; border-radius:12px; }.brand-view-info-card .label { display:block; font-size:.8rem; margin-bottom:.25rem; }.brand-view-info-card .value { display:block; font-weight:600; overflow-wrap:anywhere; }
  .brand-materials-heading { display:flex; justify-content:space-between; align-items:center; margin-bottom:.75rem; }.brand-materials-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.65rem; padding:0; margin:0; list-style:none; }.brand-material-item { display:flex; align-items:center; gap:.65rem; padding:.75rem; border:1px solid #e5e7eb; border-radius:10px; background:#f8fafc; }.brand-material-item i { color:#198754; }
  @media (max-width:576px) { .brand-view-info,.brand-materials-list { grid-template-columns:1fr; } #brandViewModal .modal-body { padding:1rem; } }
</style>
<div class="modal fade" id="brandViewModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title"><i class="bi bi-eye me-2"></i> استعراض بيانات الماركة</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body" id="brandViewBody"></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button></div></div></div></div>
<div class="modal fade" id="brandExportModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title"><i class="bi bi-download"></i> خيارات التصدير</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><p>اختر صيغة الملف للماركات المحددة.</p><div class="d-grid gap-2"><button class="btn btn-outline-success" onclick="exportBrands('excel')"><i class="bi bi-file-earmark-excel"></i> Excel</button><button class="btn btn-outline-danger" onclick="exportBrands('pdf')"><i class="bi bi-file-earmark-pdf"></i> PDF</button></div></div></div></div></div>

<script>
const selectedBrandIds=()=>[...document.querySelectorAll('.brand-check:checked')].map((el)=>Number(el.value));const brandModal=()=>bootstrap.Modal.getOrCreateInstance(document.getElementById('brandModal'));const esc=(v)=>String(v??'').replace(/[&<>"']/g,(c)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
function openBrandModal(){document.getElementById('brandModalTitle').textContent='إضافة ماركة';document.getElementById('brandForm').reset();document.getElementById('brandId').value='';document.querySelectorAll('.brand-material').forEach((el)=>el.checked=false);}
async function editBrand(id){const d=await fetch(`/costs/brands/${id}`).then((r)=>r.json());if(!d.success)return alert(d.message);document.getElementById('brandModalTitle').textContent='تعديل ماركة';document.getElementById('brandId').value=d.brand.id;document.getElementById('brandName').value=d.brand.brand_name||'';document.getElementById('brandOwner').value=d.brand.owner_name||'';document.getElementById('brandContact').value=d.brand.contact_number||'';document.getElementById('brandAddress').value=d.brand.address||'';document.querySelectorAll('.brand-material').forEach((el)=>el.checked=d.material_ids.includes(Number(el.value)));brandModal().show();}
async function saveBrand(){const form=document.getElementById('brandForm');if(!form.reportValidity())return;const id=document.getElementById('brandId').value;const body={brand_name:brandName.value,owner_name:brandOwner.value,contact_number:brandContact.value,address:brandAddress.value,material_ids:[...document.querySelectorAll('.brand-material:checked')].map((el)=>Number(el.value))};const d=await fetch(id?`/costs/brands/${id}`:'/costs/brands',{method:id?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).then((r)=>r.json());if(!d.success)return alert(d.message);location.reload();}
function requestDeleteBrand(id){document.querySelectorAll('.brand-check').forEach((el)=>el.checked=Number(el.value)===id);updateSelection();openDeleteModal();}
function openDeleteModal(){const ids=selectedBrandIds();if(!ids.length)return alert('يرجى تحديد ماركة واحدة على الأقل');deleteBrandMessage.textContent=`هل تريد حذف ${ids.length} ماركة محددة؟`;bootstrap.Modal.getOrCreateInstance(document.getElementById('deleteBrandModal')).show();}
async function confirmDeleteBrands(){const d=await fetch('/costs/brands/delete-multiple',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids:selectedBrandIds()})}).then((r)=>r.json());if(!d.success)return alert(d.message);location.reload();}
async function viewBrand(id){const d=await fetch(`/costs/brands/${id}`).then((r)=>r.json());if(!d.success)return alert(d.message);const names=[...document.querySelectorAll('.brand-material')].filter((el)=>d.material_ids.includes(Number(el.value))).map((el)=>el.parentElement.querySelector('span').childNodes[0].textContent.trim());brandViewBody.innerHTML=`<div class="brand-view-hero"><div class="brand-view-icon"><i class="bi bi-tag-fill"></i></div><div><h4>${esc(d.brand.brand_name)}</h4><small>تفاصيل الماركة والمواد المرتبطة بها</small></div></div><div class="brand-view-info"><div class="brand-view-info-card"><span class="label">اسم صاحبها</span><span class="value">${esc(d.brand.owner_name||'-')}</span></div><div class="brand-view-info-card"><span class="label">رقم التواصل</span><span class="value">${esc(d.brand.contact_number||'-')}</span></div><div class="brand-view-info-card"><span class="label">العنوان</span><span class="value">${esc(d.brand.address||'-')}</span></div><div class="brand-view-info-card"><span class="label">عدد المواد</span><span class="value">${names.length}</span></div></div><div class="brand-materials-heading"><h6 class="mb-0">المواد التابعة</h6><span class="badge text-bg-success">${names.length} مواد</span></div><ul class="brand-materials-list">${names.map(esc).map((n)=>`<li class="brand-material-item"><i class="bi bi-box-seam"></i><span>${n}</span></li>`).join('')||'<li class="text-muted text-center py-3">لا توجد مواد مرتبطة</li>'}</ul>`;bootstrap.Modal.getOrCreateInstance(document.getElementById('brandViewModal')).show();}
function openExportModal(){if(!selectedBrandIds().length)return alert('يرجى تحديد ماركة واحدة على الأقل');bootstrap.Modal.getOrCreateInstance(document.getElementById('brandExportModal')).show();}
async function exportBrands(type){const d=await fetch(`/costs/brands/export/${type}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids:selectedBrandIds()})}).then((r)=>r.json());if(!d.success)return alert(d.message);location.href=d.url;}
function updateSelection(){const ids=selectedBrandIds();deleteSelectedBtn.disabled=!ids.length;const all=[...document.querySelectorAll('.brand-check')];selectAllBrands.checked=all.length>0&&all.every((el)=>el.checked);}
function filterBrands(){const q=brandFilter.value.toLowerCase().trim(),mode=brandMaterialFilter.value;let count=0;document.querySelectorAll('#brandsTable tbody tr').forEach((tr)=>{const n=Number(tr.dataset.materialCount),ok=(!q||tr.dataset.search.includes(q))&&(!mode||(mode==='with'?n>0:n===0));tr.classList.toggle('d-none',!ok);if(ok)count++;});emptyBrands.classList.toggle('d-none',count>0);}
selectAllBrands.addEventListener('change',(e)=>{document.querySelectorAll('.brand-check').forEach((el)=>el.checked=e.target.checked);updateSelection();});document.querySelectorAll('.brand-check').forEach((el)=>el.addEventListener('change',updateSelection));brandFilter.addEventListener('input',filterBrands);brandMaterialFilter.addEventListener('change',filterBrands);materialSearch.addEventListener('input',(e)=>{const q=e.target.value.toLowerCase();document.querySelectorAll('.material-choice').forEach((el)=>el.classList.toggle('d-none',!el.dataset.text.includes(q)));});
</script>
